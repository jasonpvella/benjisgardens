---
import site from '../data/site.json';

const services = [
  { href: '/hedging', label: 'Hedge Trimming & Shaping' },
  { href: '/services/lawn-mowing', label: 'Lawn Mowing & Edging' },
  { href: '/services/mulching', label: 'Mulching' },
  { href: '/services/garden-maintenance', label: 'Garden Maintenance' },
  { href: '/services/pressure-washing', label: 'Pressure Washing' },
];

---

<footer class="bg-charcoal text-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 lg:py-16">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8 lg:gap-12">

      <!-- Brand -->
      <div class="lg:col-span-1">
        <img
          src="/logo.png"
          alt="Benji's Gardens"
          class="h-12 w-auto brightness-0 invert mb-5"
          width="120"
          height="48"
        />
        <p class="font-sans text-sm text-white/55 leading-relaxed mb-5">
          Sydney's hedging specialists. The final touch your garden deserves.
        </p>
        <a
          href="https://www.instagram.com/benjisgardens"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 text-white/40 hover:text-brass transition-colors"
          aria-label="Follow Benji's Gardens on Instagram"
        >
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
          </svg>
          @benjisgardens
        </a>
      </div>

      <!-- Services -->
      <div>
        <h3 class="font-sans text-xs font-medium uppercase tracking-widest text-white/35 mb-4">Services</h3>
        <ul class="space-y-2.5">
          {services.map(s => (
            <li>
              <a href={s.href} class="font-sans text-sm text-white/65 hover:text-brass transition-colors">{s.label}</a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Company Links -->
      <div>
        <h3 class="font-sans text-xs font-medium uppercase tracking-widest text-white/35 mb-4">Company</h3>
        <ul class="space-y-2.5">
          <li><a href="/gallery" class="font-sans text-sm text-white/65 hover:text-brass transition-colors">Gallery</a></li>
          <li><a href="/contact" class="font-sans text-sm text-white/65 hover:text-brass transition-colors">Contact</a></li>
          <li><a href="/about" class="font-sans text-sm text-white/65 hover:text-brass transition-colors">About</a></li>
        </ul>
      </div>

      <!-- NAP -->
      <div>
        <h3 class="font-sans text-xs font-medium uppercase tracking-widest text-white/35 mb-4">Get in Touch</h3>
        <ul class="space-y-3 mb-6">
          <li>
            <a href={site.phone_href} class="flex items-start gap-2.5 font-sans text-sm text-white/65 hover:text-brass transition-colors">
              <svg class="w-4 h-4 flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 24 24">
                <path d="M6.62 10.79c1.44 2.83 3.76 5.14 6.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z"/>
              </svg>
              {site.phone}
            </a>
          </li>
          <li>
            <a href={`mailto:${site.email}`} class="flex items-start gap-2.5 font-sans text-sm text-white/65 hover:text-brass transition-colors break-all">
              <svg class="w-4 h-4 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
              </svg>
              {site.email}
            </a>
          </li>
          <li class="flex items-start gap-2.5 font-sans text-sm text-white/65">
            <svg class="w-4 h-4 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
            </svg>
            Sydney, NSW
          </li>
        </ul>
        <a
          href="/contact#quote"
          class="inline-block bg-brass text-white font-sans text-sm font-medium px-5 py-2.5 hover:bg-brass-light transition-colors"
        >
          Get a Free Quote
        </a>
      </div>
    </div>

    <div class="border-t border-white/10 mt-12 pt-8 flex flex-col sm:flex-row justify-between items-start sm:items-center gap-3">
      <p class="font-sans text-xs text-white/25">
        © {new Date().getFullYear()} Benji's Gardens. All rights reserved. Fully insured. Sydney NSW.
      </p>
      <p class="font-sans text-xs text-white/25 italic font-serif">The final touch your garden deserves.</p>
    </div>
  </div>
</footer>
