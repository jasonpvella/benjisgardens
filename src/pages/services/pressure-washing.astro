---
import Layout from '../../layouts/Layout.astro';
---

<Layout
  title="Pressure Washing Sydney — Benji's Gardens | Driveways, Paths & Courtyards"
  description="Professional pressure washing across Sydney's Hills District, Upper North Shore and Inner West. Driveways, paths, courtyards and brick pavers restored to clean. Free quote."
  image="/images/pressure-washing-after-driveway.jpg"
>

  <!-- HERO -->
  <section class="relative min-h-[55vh] flex items-center overflow-hidden">
    <div class="absolute inset-0">
      <img
        src="/images/pressure-washing-after-driveway.jpg"
        alt="Clean brick paver driveway after professional pressure washing — Sydney"
        class="w-full h-full object-cover"
        width="1920"
        height="1080"
        fetchpriority="high"
        loading="eager"
      />
      <div class="absolute inset-0 bg-gradient-to-r from-charcoal/88 via-charcoal/60 to-charcoal/20"></div>
    </div>
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20">
      <div class="max-w-xl">
        <a href="/services" class="inline-flex items-center gap-1.5 font-sans text-xs text-white/45 hover:text-white transition-colors mb-6">
          ← All Services
        </a>
        <p class="font-sans text-xs font-medium uppercase tracking-[0.2em] text-brass mb-4">Hard Surface Cleaning</p>
        <h1 class="font-serif text-5xl sm:text-6xl text-white mb-5 leading-tight">Pressure Washing</h1>
        <p class="font-sans text-base text-ivory/75 leading-relaxed mb-8">
          Driveways, paths, courtyards, and brick pavers — restored to clean. The fastest way to transform how a property presents from the street.
        </p>
        <a href="/contact#quote" class="inline-flex items-center gap-2 bg-brass text-white font-sans font-medium text-sm px-8 py-4 hover:bg-brass-light transition-colors">
          Get a Quote
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- BEFORE / AFTER -->
  <section class="bg-ivory py-14 lg:py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-10">
        <p class="font-sans text-xs font-medium uppercase tracking-[0.2em] text-brass mb-4">The Difference</p>
        <h2 class="font-serif text-3xl lg:text-4xl text-charcoal">Before & After</h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-10">
        <div class="overflow-hidden border border-warm-gray">
          <div class="aspect-[4/3] overflow-hidden">
            <img
              src="/images/pressure-washing-before-driveway.jpg"
              alt="Dirty brick paver driveway before pressure washing — Sydney"
              class="w-full h-full object-cover"
              width="800"
              height="600"
              loading="lazy"
            />
          </div>
          <div class="px-4 py-3 bg-white flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-charcoal/30 flex-shrink-0"></span>
            <p class="font-sans text-xs text-charcoal/50 uppercase tracking-wider">Before</p>
          </div>
        </div>
        <div class="overflow-hidden border border-green-pale">
          <div class="aspect-[4/3] overflow-hidden">
            <img
              src="/images/pressure-washing-after-driveway.jpg"
              alt="Clean brick paver driveway after pressure washing — Sydney"
              class="w-full h-full object-cover"
              width="800"
              height="600"
              loading="lazy"
            />
          </div>
          <div class="px-4 py-3 bg-white flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-green-deep flex-shrink-0"></span>
            <p class="font-sans text-xs text-green-deep uppercase tracking-wider font-medium">After</p>
          </div>
        </div>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div class="overflow-hidden border border-warm-gray">
          <div class="aspect-[4/3] overflow-hidden">
            <img
              src="/images/pressure-washing-before-path.jpg"
              alt="Overgrown side path before cleaning — Sydney"
              class="w-full h-full object-cover"
              width="800"
              height="600"
              loading="lazy"
            />
          </div>
          <div class="px-4 py-3 bg-white flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-charcoal/30 flex-shrink-0"></span>
            <p class="font-sans text-xs text-charcoal/50 uppercase tracking-wider">Before</p>
          </div>
        </div>
        <div class="overflow-hidden border border-green-pale">
          <div class="aspect-[4/3] overflow-hidden">
            <img
              src="/images/pressure-washing-after-path.jpg"
              alt="Clean side path after pressure washing — Sydney"
              class="w-full h-full object-cover"
              width="800"
              height="600"
              loading="lazy"
            />
          </div>
          <div class="px-4 py-3 bg-white flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-green-deep flex-shrink-0"></span>
            <p class="font-sans text-xs text-green-deep uppercase tracking-wider font-medium">After</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- WHAT WE CLEAN -->
  <section class="bg-white py-14 lg:py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20 items-start">
        <div>
          <p class="font-sans text-xs font-medium uppercase tracking-[0.2em] text-brass mb-4">The Service</p>
          <h2 class="font-serif text-3xl lg:text-4xl text-charcoal mb-6">What We Clean</h2>
          <p class="font-sans text-sm text-charcoal/65 leading-relaxed mb-8">
            Moss, lichen, dirt, grime, and organic staining build up on hard surfaces over time — especially in Sydney's climate. High-pressure washing removes it completely, restoring surfaces to a clean finish without harsh chemicals.
          </p>
          <ul class="space-y-4 mb-8">
            {[
              { title: 'Brick Paver Driveways', body: 'The most visible surface on any property. Clean pavers dramatically improve street presence.' },
              { title: 'Concrete Paths & Footpaths', body: 'Council footpaths and internal paths — cleaned and cleared of slippery growth.' },
              { title: 'Courtyards & Entertainment Areas', body: 'Tile, stone, and concrete entertaining spaces restored for outdoor living.' },
              { title: 'Garden Paths & Steps', body: 'Natural stone and concrete garden paths cleaned safely without damaging the surface.' },
              { title: 'Retaining Walls', body: 'Sandstone, brick, and concrete retaining walls — staining and lichen removed.' },
            ].map(item => (
              <li class="flex gap-4 pb-4 border-b border-warm-gray last:border-0">
                <svg class="w-4 h-4 text-green-deep flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                </svg>
                <div>
                  <p class="font-sans text-sm font-medium text-charcoal">{item.title}</p>
                  <p class="font-sans text-sm text-charcoal/60 mt-0.5">{item.body}</p>
                </div>
              </li>
            ))}
          </ul>
          <div class="bg-ivory p-5 border-l-2 border-brass">
            <p class="font-serif text-base text-charcoal italic leading-relaxed">
              "Often pairs well with a garden tidy-up or hedge trim — one visit to restore the whole property."
            </p>
          </div>
        </div>
        <div class="space-y-4">
          <div class="aspect-[4/3] overflow-hidden">
            <img
              src="/images/pressure-washing-after-courtyard.jpg"
              alt="Clean brick courtyard with neatly trimmed hedge — Sydney"
              class="w-full h-full object-cover"
              width="800"
              height="600"
              loading="lazy"
            />
          </div>
          <div class="aspect-[4/3] overflow-hidden">
            <img
              src="/images/pressure-washing-during.jpg"
              alt="Pressure washing a brick driveway — Benji's Gardens Sydney"
              class="w-full h-full object-cover"
              width="800"
              height="600"
              loading="lazy"
            />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="bg-charcoal py-14 lg:py-20">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="font-serif text-4xl text-white mb-4">Get a Free Pressure Washing Quote</h2>
      <p class="font-sans text-base text-white/55 mb-8 max-w-lg mx-auto">
        Tell us what surfaces need cleaning and your suburb. We'll get back to you the same day.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/contact#quote" class="inline-flex items-center justify-center gap-2 bg-brass text-white font-sans font-medium text-sm px-8 py-4 hover:bg-brass-light transition-colors">
          Get a Quote
        </a>
        <a href="tel:0493038733" class="inline-flex items-center justify-center gap-2 border border-white/30 text-white font-sans font-medium text-sm px-8 py-4 hover:border-white transition-colors">
          Call 0493 038 733
        </a>
      </div>
    </div>
  </section>

</Layout>
