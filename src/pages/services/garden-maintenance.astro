---
import Layout from '../../layouts/Layout.astro';
---

<Layout
  title="Garden Maintenance Sydney — Benji's Gardens | Hills District, North Shore, Inner West"
  description="Comprehensive garden maintenance across Sydney's Hills District, Upper North Shore and Inner West. Weeding, pruning, seasonal clean-ups and complete ongoing care. Free quote."
>
  <section class="bg-ivory py-16 lg:py-24 border-b border-warm-gray">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <a href="/services" class="inline-flex items-center gap-1.5 font-sans text-xs text-charcoal/45 hover:text-charcoal transition-colors mb-6">
        ← All Services
      </a>
      <p class="font-sans text-xs font-medium uppercase tracking-[0.2em] text-brass mb-4">Comprehensive Care</p>
      <h1 class="font-serif text-5xl lg:text-6xl text-charcoal mb-6 max-w-2xl leading-tight">Garden Maintenance</h1>
      <p class="font-sans text-base text-charcoal/65 max-w-xl leading-relaxed">
        Complete, ongoing care for gardens that deserve to look their best all year. Everything from weeding and pruning to seasonal clean-ups — handled properly, on a schedule that suits you.
      </p>
    </div>
  </section>

  <section class="bg-white py-16 lg:py-24">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20 items-start">
        <div class="space-y-4">
          <div class="aspect-[4/3] overflow-hidden">
            <img
              src="/images/benji-hedging-suburban.jpg"
              alt="Well-maintained garden — Benji's Gardens Sydney"
              class="w-full h-full object-cover"
              width="800"
              height="600"
              loading="lazy"
            />
          </div>
          <div class="aspect-[4/3] overflow-hidden">
            <img
              src="/images/benji-hedging-large-hedge.jpg"
              alt="Comprehensive garden maintenance including hedging — Five Dock"
              class="w-full h-full object-cover"
              width="800"
              height="600"
              loading="lazy"
            />
          </div>
        </div>
        <div>
          <h2 class="font-serif text-3xl text-charcoal mb-6">What We Cover</h2>
          <div class="space-y-4 mb-10">
            {[
              { title: 'Weeding', body: 'Thorough hand-weeding of garden beds. We get the roots — not just the tops.' },
              { title: 'Shrub & Plant Pruning', body: 'Light pruning to maintain shape, encourage healthy growth, and keep plants in proportion with the garden.' },
              { title: 'Seasonal Clean-Ups', body: 'Spring and autumn tidy-ups: removing spent growth, cutting back over-winter dieback, preparing beds for the coming season.' },
              { title: 'Garden Bed Maintenance', body: 'Edging bed borders, topping up mulch, removing leaf litter, and keeping beds defined and tidy.' },
              { title: 'General Tidying', body: 'Collecting and removing leaf litter, blowing paths and hard surfaces clean, and leaving the property immaculate.' },
            ].map(item => (
              <div class="flex gap-4 pb-4 border-b border-warm-gray last:border-0">
                <div class="w-1 h-auto flex-shrink-0 bg-brass self-stretch rounded-full"></div>
                <div>
                  <p class="font-sans text-sm font-medium text-charcoal mb-1">{item.title}</p>
                  <p class="font-sans text-sm text-charcoal/60 leading-relaxed">{item.body}</p>
                </div>
              </div>
            ))}
          </div>
          <div class="bg-green-deep p-6 mb-6">
            <p class="font-serif text-lg text-white mb-2">Ongoing seasonal care available</p>
            <p class="font-sans text-sm text-white/60 leading-relaxed">
              Regular maintenance tailored to your garden's needs throughout the year. Ask us about ongoing care when you get your quote.
            </p>
          </div>
          <div class="flex gap-4">
            <a href="/contact#quote" class="inline-flex items-center gap-2 bg-green-deep text-white font-sans font-medium text-sm px-6 py-3 hover:bg-green-mid transition-colors">
              Get a Quote
            </a>
            <a href="tel:0493038733" class="inline-flex items-center gap-2 border border-warm-gray text-charcoal font-sans font-medium text-sm px-6 py-3 hover:border-green-deep hover:text-green-deep transition-colors">
              0493 038 733
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>
