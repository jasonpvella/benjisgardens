---
import Layout from '../../layouts/Layout.astro';
---

<Layout
  title="Lawn Mowing & Edging Sydney — Benji's Gardens | Hills District, North Shore, Inner West"
  description="Professional lawn mowing and edging across Sydney's Hills District, Upper North Shore and Inner West. Reliable scheduling, clean finish, no mess. Free quote."
>
  <section class="bg-ivory py-16 lg:py-24 border-b border-warm-gray">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <a href="/services" class="inline-flex items-center gap-1.5 font-sans text-xs text-charcoal/45 hover:text-charcoal transition-colors mb-6">
        ← All Services
      </a>
      <p class="font-sans text-xs font-medium uppercase tracking-[0.2em] text-brass mb-4">Regular Service</p>
      <h1 class="font-serif text-5xl lg:text-6xl text-charcoal mb-6 max-w-2xl leading-tight">Lawn Mowing & Edging</h1>
      <p class="font-sans text-base text-charcoal/65 max-w-xl leading-relaxed">
        Reliable, professional mowing every visit. Clean edges, proper trimming around garden beds and obstacles, and a thorough site cleanup before we leave.
      </p>
    </div>
  </section>

  <section class="bg-white py-16 lg:py-24">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20 items-start">
        <div>
          <h2 class="font-serif text-3xl text-charcoal mb-6">What's Included</h2>
          <ul class="space-y-4 mb-10">
            {[
              { title: 'Lawn Mowing', body: 'Cut to the correct height for the grass type and season. Never scalped, never left too long.' },
              { title: 'Edge Trimming', body: 'Crisp, straight edges along paths, driveways, and garden beds. The detail that makes the difference.' },
              { title: 'Line Trimming', body: 'Around fences, trees, raised beds, and obstacles that the mower can\'t reach.' },
              { title: 'Clipping Removal', body: 'Grass clippings blown from hard surfaces and removed or mulched back into the lawn.' },
              { title: 'Site Cleanup', body: 'We leave your property clean. No clippings on paths or driveways, no mess.' },
            ].map(item => (
              <li class="flex gap-4 pb-4 border-b border-warm-gray last:border-0">
                <svg class="w-4 h-4 text-green-deep flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                </svg>
                <div>
                  <p class="font-sans text-sm font-medium text-charcoal">{item.title}</p>
                  <p class="font-sans text-sm text-charcoal/60 mt-0.5">{item.body}</p>
                </div>
              </li>
            ))}
          </ul>
          <div class="bg-ivory p-6 border-l-2 border-brass">
            <p class="font-serif text-lg text-charcoal italic">
              "Regular mowing keeps a garden looking its best year-round — and saves time on every visit."
            </p>
          </div>
        </div>
        <div class="space-y-4">
          <div class="aspect-[4/3] overflow-hidden">
            <img
              src="/images/benji-hedging-closeup.jpg"
              alt="Professional garden maintenance — Benji's Gardens Sydney"
              class="w-full h-full object-cover"
              width="800"
              height="600"
              loading="lazy"
            />
          </div>
          <div class="aspect-[4/3] overflow-hidden">
            <img
              src="/images/benji-hedging-large-hedge.jpg"
              alt="Complete garden upkeep — mowing and maintenance by Benji's Gardens"
              class="w-full h-full object-cover"
              width="800"
              height="600"
              loading="lazy"
            />
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-charcoal py-14 lg:py-20">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="font-serif text-4xl text-white mb-4">Get a Free Mowing Quote</h2>
      <p class="font-sans text-base text-white/55 mb-8">We reply same day. Tell us your suburb and block size.</p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/contact#quote" class="inline-flex items-center justify-center gap-2 bg-brass text-white font-sans font-medium text-sm px-8 py-4 hover:bg-brass-light transition-colors">
          Get a Quote
        </a>
        <a href="tel:0493038733" class="inline-flex items-center justify-center gap-2 border border-white/30 text-white font-sans font-medium text-sm px-8 py-4 hover:border-white transition-colors">
          Call 0493 038 733
        </a>
      </div>
    </div>
  </section>
</Layout>
