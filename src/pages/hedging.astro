---
import Layout from '../layouts/Layout.astro';

const schema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "Hedge Trimming & Shaping Sydney",
  "provider": {
    "@type": "LocalBusiness",
    "name": "Benji's Gardens",
    "telephone": "0493038733",
    "url": "https://benjisgardens.com.au"
  },
  "description": "Expert hedge trimming and shaping across Sydney's Hills District, Upper North Shore and Inner West. Specialising in formal buxus, lilly pilly, leighton green, murraya and camellia screens.",
  "areaServed": ["Hills District NSW", "Upper North Shore NSW", "Inner West NSW"]
};
---

<Layout
  title="Hedge Trimming & Shaping Sydney — Benji's Gardens | Hills District, North Shore, Inner West"
  description="Sydney's dedicated hedging specialists. Expert trimming of formal buxus, lilly pilly, leighton green and murraya across the Hills District, Upper North Shore and Inner West. Free quotes."
  image="/images/benji-hedging-topdown.jpg"
  schema={schema}
>

  <!-- HERO -->
  <section class="relative min-h-[70vh] flex items-center overflow-hidden">
    <div class="absolute inset-0">
      <img
        src="/images/north-shore-estate-hedge-wall.jpg"
        alt="Immaculate leighton green hedge wall at an Upper North Shore estate — Benji's Gardens"
        class="w-full h-full object-cover object-center"
        width="1920"
        height="1080"
        fetchpriority="high"
        loading="eager"
      />
      <div class="absolute inset-0 bg-gradient-to-r from-charcoal/90 via-charcoal/65 to-charcoal/25"></div>
    </div>
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20">
      <div class="max-w-2xl">
        <p class="font-sans text-xs font-medium uppercase tracking-[0.2em] text-brass mb-5">Our Speciality</p>
        <h1 class="font-serif text-5xl sm:text-6xl lg:text-7xl text-white leading-[1.05] mb-6">
          Hedging<br />Mastery
        </h1>
        <p class="font-sans text-base text-ivory/75 leading-relaxed mb-8 max-w-lg">
          Formal hedging demands more than a pair of shears. It demands an understanding of the species, the season, the structure — and the patience to get every line exactly right.
        </p>
        <a
          href="/contact#quote"
          class="inline-flex items-center gap-2 bg-brass text-white font-sans font-medium text-sm px-8 py-4 hover:bg-brass-light transition-colors"
        >
          Get a Hedging Quote
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- WHAT WE DO -->
  <section class="bg-ivory py-16 lg:py-24">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20 items-center">
        <div>
          <p class="font-sans text-xs font-medium uppercase tracking-[0.2em] text-brass mb-4">The Craft</p>
          <h2 class="font-serif text-4xl lg:text-5xl text-charcoal mb-6 leading-tight">
            Why Hedging Is<br />a Specialist's Work
          </h2>
          <p class="font-sans text-base text-charcoal/65 leading-relaxed mb-4">
            Most garden maintenance teams can cut a hedge. Very few can shape one correctly. The difference is visible — in the geometry, the plant health over time, and the way the garden reads from the street.
          </p>
          <p class="font-sans text-base text-charcoal/65 leading-relaxed mb-4">
            We work with the most common hedging species in Sydney's premium gardens: formal <strong class="text-charcoal font-medium">buxus</strong>, tall <strong class="text-charcoal font-medium">lilly pilly</strong> screens, dense <strong class="text-charcoal font-medium">leighton green</strong> conifers, fragrant <strong class="text-charcoal font-medium">murraya</strong> panels, and <strong class="text-charcoal font-medium">camellia</strong> privacy screens.
          </p>
          <p class="font-sans text-base text-charcoal/65 leading-relaxed">
            Each species has a preferred season for hard reduction, a natural growth pattern, and a tolerance (or intolerance) for cutting into old wood. Getting it wrong means slow regrowth, bare patches, or a plant under permanent stress. Getting it right means a hedge that improves every year.
          </p>
        </div>
        <div class="aspect-[4/5] overflow-hidden">
          <img
            src="/images/benji-hedging-federation-house.jpg"
            alt="Benji shaping a tall formal hedge at a heritage property in Five Dock, Inner West Sydney"
            class="w-full h-full object-cover"
            width="800"
            height="1000"
            loading="lazy"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- SERVICES LIST -->
  <section class="bg-white py-16 lg:py-24">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <p class="font-sans text-xs font-medium uppercase tracking-[0.2em] text-brass mb-4">What's Included</p>
        <h2 class="font-serif text-4xl lg:text-5xl text-charcoal">Our Hedging Services</h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {[
          {
            title: 'Formal Hedge Trimming',
            desc: 'Precise shaping of established hedges to maintain clean lines, level tops, and vertical faces. Species-appropriate timing and technique for every cut.',
          },
          {
            title: 'Hedge Reduction',
            desc: 'Controlled size reduction of hedges that have grown too large — without compromising plant health or structural integrity. Done at the right time of year for each species.',
          },
          {
            title: 'Overgrown Hedge Restoration',
            desc: 'Bringing neglected hedges back to a manageable, attractive form. We assess what\'s salvageable and execute a multi-stage restoration plan.',
          },
          {
            title: 'Topiary & Formal Shaping',
            desc: 'Spheres, columns, cones, and geometric forms. Low formal buxus edging, specimen topiaries, and architectural features in the garden.',
          },
          {
            title: 'New Hedge Establishment',
            desc: 'Formative pruning of newly planted hedging to encourage dense, even growth from the base. The most important cuts happen early.',
          },
          {
            title: 'Screen & Privacy Hedging',
            desc: 'Tall lilly pilly and murraya screens shaped for maximum density and uniform height — the most effective living privacy solutions.',
          },
        ].map(service => (
          <div class="p-7 border border-warm-gray hover:border-green-pale hover:bg-ivory transition-colors">
            <div class="w-6 h-0.5 bg-brass mb-4"></div>
            <h3 class="font-serif text-xl text-charcoal mb-3">{service.title}</h3>
            <p class="font-sans text-sm text-charcoal/60 leading-relaxed">{service.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- SPECIES WE WORK WITH -->
  <section class="bg-green-deep py-16 lg:py-24">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <p class="font-sans text-xs font-medium uppercase tracking-[0.2em] text-brass mb-4">Our Expertise</p>
        <h2 class="font-serif text-4xl lg:text-5xl text-white mb-4">Species We Work With</h2>
        <p class="font-sans text-base text-white/55 max-w-xl mx-auto">
          Every species behaves differently. We know when to cut, how much to take, and what the plant needs to recover well.
        </p>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {[
          { name: 'Buxus (Box)', note: 'Formal topiary and low edging. Prune in late spring after new growth hardens.' },
          { name: 'Lilly Pilly', note: 'Privacy screens and tall hedges. Tolerates hard cutting; responds well to regular trimming.' },
          { name: 'Leighton Green', note: 'Fast-growing conifer. Requires precise reduction — cuts into old wood won\'t regenerate.' },
          { name: 'Murraya', note: 'Dense, fragrant screens. Best trimmed after flowering; avoid cutting in cold snaps.' },
          { name: 'Camellia', note: 'Formal screens with seasonal flower. Prune immediately after flowering to preserve next year\'s buds.' },
          { name: 'Photinia', note: 'Striking new red growth. Regular light trimming keeps foliage dense and displays the colour.' },
        ].map(species => (
          <div class="flex gap-4 p-5 bg-white/5 border border-white/10">
            <div class="w-1 flex-shrink-0 bg-brass self-stretch rounded-full"></div>
            <div>
              <h3 class="font-serif text-xl text-white mb-1">{species.name}</h3>
              <p class="font-sans text-sm text-white/50 leading-relaxed">{species.note}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- FEATURE PHOTO -->
  <div class="w-full overflow-hidden">
    <img
      src="/images/inner-west-layered-hedge.jpg"
      alt="Tall lilly pilly screen over a low formal buxus border — Inner West Sydney"
      class="w-full h-auto"
      width="1080"
      height="1080"
      loading="lazy"
    />
  </div>

  <!-- CTA -->
  <section class="bg-charcoal py-16 lg:py-24">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <p class="font-sans text-xs font-medium uppercase tracking-[0.2em] text-brass mb-5">Free Quote</p>
      <h2 class="font-serif text-4xl lg:text-6xl text-white mb-6">Ready to Transform Your Hedges?</h2>
      <p class="font-sans text-base text-white/55 mb-10 max-w-xl mx-auto">
        Get a free quote — we reply same day. Tell us what species you have and we'll give you an honest assessment.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/contact#quote" class="inline-flex items-center justify-center gap-2 bg-brass text-white font-sans font-medium text-sm px-10 py-4 hover:bg-brass-light transition-colors">
          Get a Hedging Quote
        </a>
        <a href="tel:0493038733" class="inline-flex items-center justify-center gap-2 border border-white/30 text-white font-sans font-medium text-sm px-10 py-4 hover:border-white transition-colors">
          Call 0493 038 733
        </a>
      </div>
    </div>
  </section>

</Layout>
