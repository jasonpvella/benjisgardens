---
import Layout from '../layouts/Layout.astro';

const schema = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "name": "Benji's Gardens",
  "description": "Sydney's hedging specialists serving the Hills District, Upper North Shore, and Inner West. Premium garden maintenance, hedge trimming, lawn mowing, and care plans.",
  "telephone": "0493038733",
  "email": "benjikerkin23@gmail.com",
  "url": "https://benjisgardens.com.au",
  "image": "https://benjisgardens.com.au/images/benji-hedging-large-hedge.jpg",
  "priceRange": "$$",
  "areaServed": ["Hills District NSW", "Upper North Shore NSW", "Inner West NSW"],
  "address": {
    "@type": "PostalAddress",
    "addressRegion": "NSW",
    "addressCountry": "AU"
  },
  "sameAs": ["https://www.instagram.com/benjisgardens"]
};
---

<Layout
  title="Benji's Gardens — Sydney's Hedging Specialists | Hills District, North Shore & Inner West"
  description="Sydney's hedging specialists. Expert hedge trimming, lawn mowing, mulching & garden maintenance across the Hills District, Upper North Shore & Inner West. Get a free quote today."
  schema={schema}
>

  <!-- HERO -->
  <section class="relative min-h-[85vh] lg:min-h-screen flex items-end lg:items-center overflow-hidden">
    <div class="absolute inset-0">
      <img
        src="/images/highend-formal-garden.jpg"
        alt="Immaculate formal buxus garden with granite path — Sydney"
        class="w-full h-full object-cover object-center"
        fetchpriority="high"
        loading="eager"
      />
      <div class="absolute inset-0 bg-gradient-to-b from-charcoal/20 via-charcoal/50 to-charcoal/90 lg:bg-gradient-to-r lg:from-charcoal/85 lg:via-charcoal/60 lg:to-charcoal/20"></div>
    </div>
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-14 lg:py-32 w-full">
      <div class="max-w-2xl">
        <p class="font-sans text-xs font-medium uppercase tracking-[0.2em] text-white/75 mb-4 lg:mb-5">
          Hills District · Upper North Shore · Inner West
        </p>
        <h1 class="font-serif text-4xl sm:text-5xl lg:text-7xl xl:text-7xl text-white leading-[1.05] mb-4 lg:mb-6">
          Sydney's Hedging,<br />Lawn & Garden<br />Specialists
        </h1>
        <p class="font-serif text-lg lg:text-2xl text-ivory/80 italic mb-6 lg:mb-10 leading-relaxed">
          The final touch your garden deserves.
        </p>
        <div class="flex flex-col sm:flex-row gap-3">
          <a
            href="/contact#quote"
            class="inline-flex items-center justify-center gap-2 bg-brass text-white font-sans font-medium text-sm px-8 py-4 hover:bg-brass-light transition-colors"
          >
            Get a Free Quote
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
            </svg>
          </a>
          <a
            href="tel:0493038733"
            class="inline-flex items-center justify-center gap-2 border border-white/40 text-white font-sans font-medium text-sm px-8 py-4 hover:border-white hover:bg-white/10 transition-colors"
          >
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
              <path d="M6.62 10.79c1.44 2.83 3.76 5.14 6.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z"/>
            </svg>
            0493 038 733
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- TRUST BAR -->
  <section class="bg-white border-b border-warm-gray">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col sm:flex-row items-center justify-center divide-y sm:divide-y-0 sm:divide-x divide-warm-gray">
        <div class="flex items-center gap-2.5 px-6 lg:px-10 py-4 sm:py-5">
          <div class="flex text-brass">
            {[...Array(5)].map(() => (
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
              </svg>
            ))}
          </div>
          <span class="font-sans text-sm font-medium text-charcoal">Google Rated 5.0</span>
        </div>
        <div class="flex items-center gap-2.5 px-6 lg:px-10 py-4 sm:py-5">
          <svg class="w-5 h-5 text-green-deep" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
          </svg>
          <span class="font-sans text-sm font-medium text-charcoal">Fully Insured</span>
        </div>
        <div class="flex items-center gap-2.5 px-6 lg:px-10 py-4 sm:py-5">
          <svg class="w-5 h-5 text-green-deep" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
          </svg>
          <span class="font-sans text-sm font-medium text-charcoal">Hills District · North Shore · Inner West</span>
        </div>
        <div class="flex items-center gap-2.5 px-6 lg:px-10 py-4 sm:py-5">
          <svg class="w-5 h-5 text-green-deep" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
          </svg>
          <span class="font-sans text-sm font-medium text-charcoal">Free On-Site Quotes</span>
        </div>
      </div>
    </div>
  </section>

  <!-- CRAFT SHOWCASE -->
  <section class="bg-ivory py-16 lg:py-24">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-16 items-center">
        <div>
          <p class="font-sans text-xs font-medium uppercase tracking-[0.2em] text-brass mb-4">The Craft</p>
          <h2 class="font-serif text-4xl lg:text-5xl text-charcoal mb-6 leading-tight">
            Precision That<br />Shows in Every Line
          </h2>
          <p class="font-sans text-base text-charcoal/65 leading-relaxed mb-6">
            Formal hedging is rare, demanding, and — when done right — one of the most striking things a garden can offer. Clean geometry, correct seasonal timing, and a thorough understanding of each species: buxus, lilly pilly, leighton green, murraya, camellia screens.
          </p>
          <p class="font-sans text-base text-charcoal/65 leading-relaxed mb-8">
            We document every transformation. Before and after galleries coming soon.
          </p>
          <a
            href="/hedging"
            class="inline-flex items-center gap-2 font-sans text-sm font-medium text-green-deep hover:text-green-mid transition-colors"
          >
            Our hedging work
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
            </svg>
          </a>
        </div>
        <div class="aspect-video overflow-hidden">
          <video
            class="w-full h-full object-cover"
            poster="/images/benji-hedging-large-hedge.jpg"
            autoplay
            muted
            loop
            playsinline
            preload="none"
            aria-label="Benji's Gardens — hedge trimming in action"
          >
            <source src="/videos/hedging-job.mp4" type="video/mp4" />
          </video>
        </div>
      </div>
    </div>
  </section>

  <!-- WHY CHOOSE -->
  <section class="bg-white py-10 lg:py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-8 lg:mb-10">
        <p class="font-sans text-xs font-medium uppercase tracking-[0.2em] text-brass mb-3">Why Benji's Gardens</p>
        <h2 class="font-serif text-4xl lg:text-5xl text-charcoal">What Sets Us Apart</h2>
      </div>
      <div class="grid grid-cols-2 lg:grid-cols-3 gap-3 lg:gap-5">
        {[
          { icon: '✦', title: 'Hedging Specialists', body: 'We lead with hedging — the most craft-intensive service in garden maintenance. Most teams treat it as an afterthought.' },
          { icon: '✦', title: 'Fully Insured', body: 'Public liability insurance for every job. You\'re protected, and so are we.' },
          { icon: '✦', title: 'Professional-Grade Equipment', body: 'STIHL long-reach trimmers, proper PPE, and tools maintained to a professional standard.' },
          { icon: '✦', title: 'Free On-Site Quotes', body: 'No obligation, no surprises. We come to you, assess the job, and give you a clear price before any work begins.' },
          { icon: '✦', title: 'Clean-Site Finish', body: 'Every job ends with a full cleanup. We leave your property exactly as we found it — just with better hedges.' },
          { icon: '✦', title: 'Ongoing Seasonal Care', body: 'Regular maintenance tailored to your garden\'s needs throughout the year.' },
        ].map(item => (
          <div class="p-4 lg:p-5 border border-warm-gray hover:border-green-pale hover:bg-ivory transition-colors">
            <span class="text-brass text-xs mb-2 block">{item.icon}</span>
            <h3 class="font-serif text-lg lg:text-xl text-charcoal mb-1.5">{item.title}</h3>
            <p class="font-sans text-xs lg:text-sm text-charcoal/60 leading-relaxed">{item.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- HEDGING FEATURE -->
  <section class="relative py-20 lg:py-32 overflow-hidden">
    <div class="absolute inset-0">
      <img
        src="/images/north-shore-estate-hedge-wall.jpg"
        alt="Immaculate leighton green hedge wall at an Upper North Shore estate — Benji's Gardens"
        class="w-full h-full object-cover"
        width="1920"
        height="1080"
        loading="lazy"
      />
      <div class="absolute inset-0 bg-green-deep/88"></div>
    </div>
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-2xl">
        <p class="font-sans text-xs font-medium uppercase tracking-[0.2em] text-brass mb-5">Our Speciality</p>
        <h2 class="font-serif text-4xl lg:text-6xl text-white mb-6 leading-tight">
          Hedging Mastery.<br />Line by Line.
        </h2>
        <p class="font-sans text-base text-white/90 leading-relaxed mb-8">
          From restoring an overgrown lilly pilly screen to sculpting formal buxus topiary on Upper North Shore estates — precise hedging is what we do best. Seasonal timing, plant health, and straight geometry that holds for years.
        </p>
        <a
          href="/hedging"
          class="inline-flex items-center gap-2 bg-brass text-white font-sans font-medium text-sm px-8 py-4 hover:bg-brass-light transition-colors"
        >
          See Our Hedging Work
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- SERVICES GRID -->
  <section class="bg-ivory py-16 lg:py-24">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <p class="font-sans text-xs font-medium uppercase tracking-[0.2em] text-brass mb-4">What We Do</p>
        <h2 class="font-serif text-4xl lg:text-5xl text-charcoal">Complete Garden Care</h2>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-px bg-warm-gray">
        {[
          {
            href: '/hedging',
            img: '/images/highend-formal-garden.jpg',
            title: 'Hedge Trimming & Shaping',
            body: 'Our specialty. Formal lines, seasonal reductions, species-specific care. From buxus to lilly pilly screens.',
          },
          {
            href: '/services/lawn-mowing',
            img: '/images/highend-lawn-edging.jpg',
            title: 'Lawn Mowing & Edging',
            body: 'Regular mowing with clean edges. Reliable scheduling, professional finish, no mess left behind.',
          },
          {
            href: '/services/mulching',
            img: '/images/highend-mulching.jpg',
            title: 'Mulching',
            body: 'Quality mulch applied to suppress weeds, retain moisture, and give garden beds a finished, premium look.',
          },
          {
            href: '/services/garden-maintenance',
            img: '/images/highend-garden-maintenance.jpg',
            title: 'Garden Maintenance',
            body: 'Comprehensive ongoing care: weeding, pruning, seasonal clean-ups. Everything your garden needs to thrive.',
          },
          {
            href: '/services/pressure-washing',
            img: '/images/pressure-washing-after-driveway.jpg',
            title: 'Pressure Washing',
            body: 'Driveways, paths, and courtyards restored to a clean finish. Before-and-after results that speak for themselves.',
          },
        ].map(service => (
          <a href={service.href} class="group bg-white block overflow-hidden hover:shadow-sm transition-shadow">
            <div class="aspect-[4/3] overflow-hidden">
              <img
                src={service.img}
                alt={service.title}
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                width="600"
                height="450"
                loading="lazy"
              />
            </div>
            <div class="p-6">
              <h3 class="font-serif text-xl text-charcoal mb-2">{service.title}</h3>
              <p class="font-sans text-sm text-charcoal/60 leading-relaxed mb-4">{service.body}</p>
              <span class="font-sans text-xs font-medium text-green-deep group-hover:text-green-mid transition-colors">
                Learn more →
              </span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>


  <!-- REVIEWS PLACEHOLDER -->
  <section class="bg-ivory py-16 lg:py-24">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-10">
        <div class="flex justify-center text-brass mb-3">
          {[...Array(5)].map(() => (
            <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 20 20">
              <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
            </svg>
          ))}
        </div>
        <p class="font-sans text-xs font-medium uppercase tracking-[0.2em] text-brass mb-3">Client Reviews</p>
        <h2 class="font-serif text-4xl lg:text-5xl text-charcoal">What Clients Say</h2>
      </div>
      <!-- Reviews widget will go here — integrate Elfsight or Trustindex after launch -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {[
          { text: 'Benji transformed our front hedge — it looks completely different. Precise, clean, and done in half the time I expected. Highly recommend.', author: 'Sarah M.', suburb: 'Five Dock' },
          { text: 'Finally found someone who actually knows how to shape a formal hedge properly. The attention to detail is exceptional. We\'ve booked him on a care plan now.', author: 'James K.', suburb: 'Pymble' },
          { text: 'Professional, reliable, and the result speaks for itself. Our lilly pilly screens look better than they ever have. Worth every cent.', author: 'Michelle T.', suburb: 'Dural' },
        ].map(review => (
          <div class="bg-white p-6 border border-warm-gray">
            <div class="flex text-brass mb-4">
              {[...Array(5)].map(() => (
                <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
                  <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                </svg>
              ))}
            </div>
            <p class="font-serif text-lg text-charcoal leading-relaxed mb-4 italic">"{review.text}"</p>
            <div>
              <p class="font-sans text-sm font-medium text-charcoal">{review.author}</p>
              <p class="font-sans text-xs text-charcoal/45">{review.suburb}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- AREAS SERVED -->
  <section class="bg-white py-16 lg:py-24">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <p class="font-sans text-xs font-medium uppercase tracking-[0.2em] text-brass mb-4">Where We Work</p>
        <h2 class="font-serif text-4xl lg:text-5xl text-charcoal">Service Areas</h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {[
          {
            href: '/areas/hills-district',
            title: 'Hills District',
            suburbs: 'Kenthurst · Dural · Glenorie · Glenhaven · Middle Dural',
            desc: 'Large acreage blocks and equestrian estates. Large-scale hedging, screening, and grounds upkeep at scale.',
          },
          {
            href: '/areas/north-shore',
            title: 'Upper North Shore',
            suburbs: 'Killara · Pymble · St Ives · Wahroonga · Gordon · Lindfield',
            desc: 'Large blocks, mature formal hedges, manicured aesthetic. The prestige-hedging heartland of Sydney.',
          },
          {
            href: '/areas/inner-west',
            title: 'Inner West',
            suburbs: 'Five Dock · Haberfield · Balmain · Birchgrove · Hunters Hill',
            desc: 'Heritage Federation gardens and compact prestige courtyards. Precision in tight, treasured spaces.',
          },
        ].map(area => (
          <a href={area.href} class="group block p-8 border border-warm-gray hover:border-green-pale hover:shadow-sm transition-all">
            <div class="w-8 h-0.5 bg-brass mb-5"></div>
            <h3 class="font-serif text-2xl text-charcoal mb-2 group-hover:text-green-deep transition-colors">{area.title}</h3>
            <p class="font-sans text-xs text-brass mb-3 tracking-wide">{area.suburbs}</p>
            <p class="font-sans text-sm text-charcoal/60 leading-relaxed mb-5">{area.desc}</p>
            <span class="font-sans text-xs font-medium text-green-deep group-hover:text-green-mid transition-colors">
              Learn more →
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- MEET BENJI -->
  <section class="bg-ivory py-16 lg:py-24">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20 items-center">
        <div class="order-2 lg:order-1">
          <p class="font-sans text-xs font-medium uppercase tracking-[0.2em] text-brass mb-4">The Person Behind the Work</p>
          <h2 class="font-serif text-4xl lg:text-5xl text-charcoal mb-6">Meet Benji</h2>
          <p class="font-sans text-base text-charcoal/65 leading-relaxed mb-4">
            Hi — I'm Benji Kerkin, owner and operator of Benji's Gardens. I started this business because I genuinely love the craft of garden work, and hedging in particular. There's something satisfying about transforming an overgrown mess into clean, precise lines that make a property look completely different.
          </p>
          <p class="font-sans text-base text-charcoal/65 leading-relaxed mb-4">
            I work across Sydney's best neighbourhoods — the Hills District acreage, the formal gardens of the Upper North Shore, and the heritage streetscapes of the Inner West. Every job gets the same standard: professional-grade equipment, a clean-site finish, and a result I'm proud to put my name on.
          </p>
          <p class="font-sans text-base text-charcoal/65 leading-relaxed mb-8">
            Fully insured, reliable, and always happy to give advice on what your garden actually needs.
          </p>
          <div class="flex items-center gap-5">
            <a
              href="/contact#quote"
              class="inline-flex items-center gap-2 bg-green-deep text-white font-sans font-medium text-sm px-6 py-3 hover:bg-green-mid transition-colors"
            >
              Get a Quote
            </a>
            <a
              href="https://www.instagram.com/benjisgardens"
              target="_blank"
              rel="noopener noreferrer"
              class="font-sans text-sm font-medium text-charcoal/60 hover:text-green-deep transition-colors"
            >
              @benjisgardens on Instagram
            </a>
          </div>
        </div>
        <div class="order-1 lg:order-2 relative">
          <div class="aspect-[3/4] overflow-hidden">
            <img
              src="/images/benji-hedging-closeup.jpg"
              alt="Benji Kerkin — owner of Benji's Gardens, Sydney hedging specialist"
              class="w-full h-full object-cover"
              width="600"
              height="800"
              loading="lazy"
            />
          </div>
          <div class="absolute -bottom-4 -left-4 bg-green-deep text-white px-6 py-4">
            <p class="font-serif text-lg">Benji Kerkin</p>
            <p class="font-sans text-xs text-white/60 uppercase tracking-wider mt-0.5">Owner & Hedging Specialist</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- FINAL CTA -->
  <section class="bg-charcoal py-16 lg:py-24">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <p class="font-sans text-xs font-medium uppercase tracking-[0.2em] text-brass mb-5">Get Started</p>
      <h2 class="font-serif text-4xl lg:text-6xl text-white mb-6">
        Ready for a Garden That<br />Turns Heads?
      </h2>
